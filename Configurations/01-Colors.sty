%%% Document Colors %%%

% Main document color; used mainly in citation links.
\colorlet{maincolor}{\ColorOption}

% Apply the 'linkcolor' class option to the actual hyperlinks. Without
% 'colorlinks', hyperref falls back to its default and frames every link
% with a coloured rectangle instead of colouring the text itself.
\hypersetup{
    colorlinks=true,
    linkcolor=maincolor, % Internal links: chapters, sections, figures, tables.
    citecolor=maincolor, % Bibliographic citations.
    urlcolor=maincolor,  % External URLs.
    filecolor=maincolor  % Links to external files.
}

% Color used in the numeration of the chapter style 'classic'.
\colorlet{chapterdarkred}{red!30!black}

% Color used in the numeration of the chapter style 'modern'.
\colorlet{chaptergray}{gray!80!white}

% Color used in the typesetting of the front page.
\definecolor{frontpagedark}{HTML}{1c1c1c}

% Colors used in the custom block environment.
\definecolor{note}{HTML}{0969da}
\definecolor{tip}{HTML}{1a7f37}
\definecolor{warning}{HTML}{cc0000}
\definecolor{todo}{HTML}{d1242f}
